{
  "name": "@danish/pi-engineering",
  "version": "0.2.0",
  "description": "Pi Engineering: a small, bounded team for inspecting, planning, implementing, reviewing, delivering, and auditing software changes.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "agents/",
    "chains/",
    "extensions/",
    "profiles/",
    "skills/",
    "scripts/",
    "config.example.json",
    "AGENTS.md",
    "README.md",
    "THIRD_PARTY.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "software-engineering",
    "bounded-agents",
    "orchestration"
  ],
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "test:core": "node --experimental-strip-types --test test/core/*.test.ts",
    "test:workflows": "node --experimental-strip-types --test test/workflows/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run verify:runtime && npm run typecheck",
    "test": "npm run check && npm run test:core && npm run test:workflows"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/pi-engineering"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ],
      "chains": [
        "./chains"
      ]
    }
  },
  "dependencies": {
    "pi-subagents": "https://codeload.github.com/nicobailon/pi-subagents/tar.gz/105c1399d36517292cc7dbe1f56f4724de39bd10"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.2",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.74.0",
    "@types/node": "^24.10.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
