                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "READY",
                      "NOT_READY"
                    ]
                  },
                  "evidenceSummary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "requiredNextState": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800
                  }
                }
              }
