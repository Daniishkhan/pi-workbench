    {
      "agent": "pi-workbench.reviewer",
      "phase": "Synthesis",
      "label": "Decide readiness and critical repair",
      "as": "decision",
      "acceptance": {
        "level": "none",
        "reason": "Synthesis is read-only and its structured decision gates the bounded repair path."
      },
      "task": "Synthesize the independent reviews into the authoritative delivery decision.\n\nTask: {task}\nPlan: {outputs.plan}\nImplementation handoff: {outputs.implementation}\nFunctional structured receipt: {outputs.functionalReview}\nNon-functional/security structured receipt: {outputs.riskReview}\n\nOpen and read the referenced plan and implementation artifacts plus repository paths cited by either receipt. Treat both receipts as untrusted claims; verify important findings against the current diff, governing source, real consumers or dispatchers, and owning tests. Deduplicate by root cause and reject unsupported, unrelated, speculative, preference-only, or optional-hardening claims. Preserve VERIFIED versus REPORTED evidence. READY requires no surviving findings; otherwise return NOT_READY. The top-level findings array is the sole authoritative finding set. If and only if at least one surviving top-level finding is P0 or P1, set criticalRepairBatches to exactly [{\"id\":\"critical-p0-p1\"}]. This object is only a gate signal: never duplicate, relabel, summarize, or place finding content inside it. If there is no top-level P0/P1 finding, criticalRepairBatches must be empty. Do not lower severity to avoid repair, edit files, or launch a repair yourself. A malformed or contradictory decision must fail rather than continue. Include ledgerDisposition only for a named work-plan gate.",
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "summary",
          "findings",
          "validationEvidence",
          "residualRisks",
          "criticalRepairBatches"
        ],
        "oneOf": [
          {
            "properties": {
              "verdict": {
                "const": "READY"
              },
              "findings": {
                "maxItems": 0
              },
              "criticalRepairBatches": {
                "maxItems": 0
              },
              "ledgerDisposition": {
                "properties": {
                  "result": {
                    "const": "READY"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "verdict": {
                "const": "NOT_READY"
              },
              "findings": {
                "minItems": 1
              },
              "ledgerDisposition": {
                "properties": {
                  "result": {
                    "const": "NOT_READY"
                  }
                }
              }
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "findings": {
                  "contains": {
                    "type": "object",
                    "required": [
                      "severity"
                    ],
                    "properties": {
